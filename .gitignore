# What stays on your computer and never goes to GitHub.

# Python's own leftovers
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/

# Secrets: your API keys and the deploy script's keys
.env
deploy/keys.env
deploy/generated.env

# Relay's local data (made when you run it on your computer)
relay.db
relay.secret
*.sqlite
*.db

# Traces from agent runs (they can be large and may contain your data)
runs/
*.jsonl
# ...except the recordings the office plays, which are part of the app
!src/orchestrator/web/replays/*.jsonl

# Benchmark runs: only the two that evals/RESULTS.md reports are kept
evals/results/*
!evals/results/20261021-213140.json
!evals/results/20261021-213140-rescored.json
!evals/results/20261021-214435.json
!evals/results/20261021-214435-rescored.json

# Tool caches
.pytest_cache/
.ruff_cache/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Private notes, drafts and early experiments
drafts/
examples/
start_relay_local.py
