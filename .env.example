# Copy this file to .env and fill in your own values. Never commit .env.
# Any OpenAI-compatible provider works. Check your setup with: python -m orchestrator.doctor

# --- Groq (default) ---------------------------------------------------------
LLM_API_KEY=your-api-key-here
LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=https://api.groq.com/openai/v1

# --- Google Gemini (free tier via Google AI Studio) ---------------------------
# LLM_API_KEY=your-gemini-key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=your-gemini-model   (python -m orchestrator.doctor --models lists the ones your key can use)

# Optional, multi-agent mode: a different model per role (each falls back to LLM_MODEL).
# On Groq every model has its own daily limit, so this also spreads usage across quotas.
# From real runs: the small model plans well, but as Checker or Reviewer it wanders and
# approves too easily, so keep those on the big one.
# LLM_MODEL_PLANNER=openai/gpt-oss-20b
# LLM_MODEL_CODER=openai/gpt-oss-120b
# LLM_MODEL_TESTER=openai/gpt-oss-120b
# LLM_MODEL_REVIEWER=openai/gpt-oss-120b
# Optional, multi-agent mode: stop a task after this many tokens (default 100000).
# ORCH_TOKEN_BUDGET=100000

# Optional: maximum characters sent per request (default 20000, about 5,000 tokens).
# Groq's free tier rejects requests over ~8,000 tokens; providers with larger limits can go higher.
# LLM_MAX_CONTEXT_CHARS=20000

# Optional: run all model-written code (tests and the tester's scripts) in a Docker container
# with no network and a read-only filesystem. Requires Docker and a one-time image build:
#     docker build -t orchestrator-sandbox sandbox
# SANDBOX=docker

# --- The personal assistant (python -m orchestrator.web) ---------------------
# Nothing below is needed on your own computer: Relay signs you in automatically and keeps
# its data in relay.db. For a public server, see docs/DEPLOY.md.
# LLM_MODEL_CONCIERGE=openai/gpt-oss-20b     (the agent that understands requests)
# RELAY_LOCAL_NAME=Aitzaz                    (what Relay calls you in local mode)
# DATABASE_URL=postgresql://...              (default: sqlite file relay.db)
# GOOGLE_CLIENT_ID=...                       (Google sign-in, Gmail and Calendar, read-only)
# GOOGLE_CLIENT_SECRET=...
# PUBLIC_URL=http://127.0.0.1:8000           (where Google sends people back after signing in)
# ALLOWED_EMAILS=you@gmail.com,friend@gmail.com
# VAPID_PUBLIC_KEY=...                       (browser notifications; create with:
# VAPID_PRIVATE_KEY=...                       python -m orchestrator.assistant.push)
# VAPID_SUBJECT=mailto:you@gmail.com
# ASSISTANT_DAILY_TOKENS=350000              (whole site, per day; a news job uses ~60,000)
# ASSISTANT_USER_DAILY_TOKENS=150000         (each person, per day)

# --- Try it out (free tries for people without an invite, public servers only) ---------
# TRIALS=on                                  (off to switch the free tries off)
# TRIAL_TRIES=3                              (jobs each guest may run)
# TRIAL_HOURS=24                             (how long a guest's things are kept)
# TRIAL_TOKENS=60000                         (each guest)
# TRIAL_DAILY_TOKENS=150000                  (all guests together, per day)
# TRIALS_PER_DAY=25                          (new trials per day, whole site)
# TRIALS_PER_NETWORK=3                       (per network address, every 30 days)
